database:
  postgres:
    host: "localhost"
    port: 5432
    user: "postgres"
    password: ""
    dbname: "ai_novel"
    sslmode: "disable"

llm:
  chat:
    api_key: "your-api-key"
    base_url: "https://open.bigmodel.cn/api/paas/v4/"
    model: "glm-4.5-air"
    max_tokens: 2048
    timeout: "5m"
  embedding:
    api_key: "your-api-key"
    base_url: "https://open.bigmodel.cn/api/paas/v4/"
    model: "embedding-3"
    timeout: "1m"
