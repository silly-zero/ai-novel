app:
  listen_addr: "127.0.0.1:8081"
  cors_origins: "http://localhost:5173,http://127.0.0.1:5173"
  max_concurrent_generations: 2
  read_header_timeout: "5s"
  read_timeout: "15s"
  write_timeout: "30s"
  idle_timeout: "60s"
  generation_timeout: "30m"
  startup_timeout: "15s"
  shutdown_timeout: "15s"

database:
  postgres:
    host: "localhost"
    port: 5432
    user: "postgres"
    password: ""
    dbname: "ai_novel"
    sslmode: "disable"

llm:
  chat:
    api_key: "your-api-key"
    base_url: "https://open.bigmodel.cn/api/paas/v4/"
    model: "glm-4.5-air"
    max_tokens: 2048
    timeout: "5m"
  embedding:
    api_key: "your-api-key"
    base_url: "https://open.bigmodel.cn/api/paas/v4/"
    model: "embedding-3"
    timeout: "1m"

rag:
  min_similarity: 0.55
  candidate_limit: 100
  result_limit: 4
  max_queries: 4
  max_context_memories: 8
